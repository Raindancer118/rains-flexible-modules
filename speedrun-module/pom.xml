<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>speedrun-module</artifactId>
    <!-- Own version, independent of the reactor's: this module is published to the registry on its own
         schedule under its own tag (speedrun-module-vX.Y.Z), not tied to any other module's release. -->
    <version>${speedrun-module.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Speedrun</name>
    <description>
        A speedrun lobby: an advancement goal or a death policy picked from a compass's menu, a
        countdown that freezes every racer before a green block actually starts the clock, and a
        world that resets itself once the last racer has left. Used directly by chained-module too,
        which needs this module installed alongside it for the shared engine underneath both.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${modules-api.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          RainsCore's testkit: real item stacks, inventories and players without a server, so the tests
          drive the code as it is instead of through stack-factory seams added only for them.
        -->
        <dependency>
            <groupId>de.raindancer</groupId>
            <artifactId>RainsCore</artifactId>
            <version>${rainscore.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <!--
          The driver Paper ships, at its version, for tests only: the run history lives in Core's SQLite
          database, and its migration is tested against a real one — see RainsCore's pom for why.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
