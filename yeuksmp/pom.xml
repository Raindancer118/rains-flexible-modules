<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>yeuksmp</artifactId>
    <packaging>jar</packaging>

    <name>YeukSMP</name>
    <description>
        One plugin carrying six modules — claims, teleport requests, warps, moderation, the server
        pack and coloured names — for a server that wants all of them and would otherwise install six
        jars that each have to be updated separately.

        Nothing here but a build file and a descriptor. The wrapper already knows what to do with a
        jar holding more than one module: ModuleHosts.standalone reads the module count and gives
        each one a subfolder rather than letting six fight over one config.yml.
    </description>

    <properties>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>YeukSMP</plugin.name>

        <!--
          1.0.0: the first release of the bundle. It is deliberately its own version line rather than
          the highest of the six — a bundle that claimed 2.9.0 because moderation is 2.9.0 would say
          nothing about the other five, and a bundle whose number moved every time any module moved
          would be a number nobody could read. What each module is running is in the boot log, one
          line per module, straight out of its own ModuleInfo.
        -->
        <plugin.version>1.0.0</plugin.version>
    </properties>

    <dependencies>
        <!--
          The six the server asked for, and deliberately not homes or farm worlds: a bundle is a
          decision about what this server runs, not a shortcut for "everything in the repository".
          Adding one later is adding a dependency here — ServiceLoader finds it, the shade merges the
          service files, and no list anywhere else has to be edited.
        -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>claims-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>tpa-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>warp-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>moderation-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>pack-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>names-module</artifactId>
        </dependency>

        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              BundleJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
