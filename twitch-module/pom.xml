    <artifactId>twitch-module</artifactId>
    <version>${twitch-module.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Twitch</name>
    <description>
        A chat announcement on every server of the network when a Twitch channel goes live, and another when the
        stream ends. One server asks Twitch; the others are told over the network link.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${modules-api.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
