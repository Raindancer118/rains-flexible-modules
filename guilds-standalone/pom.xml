<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>guilds-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Guilds</name>
    <description>
        Rain's Guilds, as a plugin of its own: the guilds module and the standard wrapper,
        shaded together.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsGuilds</plugin.name>
        <!-- 0.1.0: guilds — ranks, bank, levels, alliances, home, chat channels, name badges.
             0.1.1: names, tags and ids one namespace; rank names unique. -->
        <!-- 0.2.0: from guild level 2 (levels.style-from) a guild paints its tag and name — colour, gradient, bold (/guild style); needs RainsCore 1.126.0. -->
        <!-- 0.3.0: the guild in the sidebar under the balance: tag and name, level with the experience to the next, bank (setting sidebar; RainsCore 1.129.0 SidebarSections). -->
        <!-- 0.4.0: more ways to level up — ores, fish, breeding, trades, crops, enchanting, raids, rivals, deposits; together bonus; weekly contracts; staff boost; level page. -->
        <!-- 0.5.0: a guild tag is a player group in every command: @DAWN (RainsCore 1.130.0 PlayerGroups). -->
        <!-- 0.6.0: a guild is a Core group (leader, officers who may edit its info, members), so a claim can belong to it. -->
        <!-- 0.6.1: a guild's group id carries its founding time, so a guild founded again under a disbanded one's name inherits nothing (security review). -->
        <!-- 0.7.0: reasons to grind — perk points and a perk tree (vault, haste, luck, scholar, prosperous, recruiter, diplomat, pathfinder), prestige past the top level, the weekly crown. -->
        <!-- 0.7.1: the vault is sealed from the empty check to the end of a disband; vault keyed by founding time; taking asks the guild as it is now (security review). -->
        <!-- 0.7.2: a vault whose file cannot be read is never taken for empty — no disband, no deposits (RainsCore 1.132.0 StashStore.isReadable; security review). -->
        <!-- 0.8.0: the guild choices menu paints the tag and the name in the colour editor, from the level the server set. -->
        <!-- 0.9.0: a network's guilds (RainsCore 2.0): one namespace of names and tags, members on any server, bank and experience written as additions, vault as rows, home with its server, chat and notices across servers; the per-server data comes into the shared database. -->
        <!-- 0.10.0: the bank is Core's treasury for the guild: it pays a claim's upkeep its officers agreed to (/claim guild pays), logged and told. -->
        <!-- 0.12.0: /guild shards opens the enchantments page (shift-click a stack of shards in your inventory to pay it in), /guild shards add pays in every shard you carry, each up to what the guild still needs. -->
        <!-- 0.13.0: /guild pay <player> <amount> — the guild pays anybody from its bank, any sum it holds, no daily limit; a new rank permission (Pay from the bank), the leader's alone by default. -->
        <!-- 0.14.0: daily bank limits per member on top of the rank's (/guild bank limit, member page); /guild bank available|pay in|pay out; the bank page takes out any amount up to the limit (shares, all, typed in an anvil). -->
        <plugin.version>0.14.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>guilds-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
