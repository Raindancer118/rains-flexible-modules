<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>worldutils-bundle</artifactId>
    <packaging>jar</packaging>

    <name>Rain's World Utils</name>
    <description>
        Everything about worlds in one jar: the world gate (lock, drain or close the Nether and the End)
        and world utils (/w, /dim, and creating, resetting and deleting worlds with a seed history), with
        RainsCore installed alongside. The two do not know about each other — the gate answers RainsCore's
        world entry rules and /w and /dim ask them — so a locked End is locked to a portal and to a
        command alike.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!--
          The name the server sees, and the name of its data folder. Two modules in the jar, so each gets
          a subfolder: plugins/RainsWorldUtils/modules/worldgate/ and .../modules/worldutils/. A server
          coming from RainsWorldGate moves its worldgate.yml and config.yml into modules/worldgate/, or the
          gate starts open — and removes RainsWorldGate.jar: two copies of the gate are two portal listeners.
        -->
        <plugin.name>RainsWorldUtils</plugin.name>
        <!-- 0.1.0: the first release. 0.x until it is everything that was asked for. Needs RainsCore 1.36.0.
             0.1.1: /dim and /w found "nowhere safe" in a nether or end nobody was standing in — RainsCore
             1.36.1 keeps a chunk loaded for the ground search; a Nether landing never goes on the roof.
             Needs RainsCore 1.36.1. -->
        <plugin.version>0.1.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>worldgate-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>worldutils-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- BundleJarTest reads the jar this build produces, so it has to run after it exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
