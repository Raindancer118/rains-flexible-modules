<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>enchants-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Enchants</name>
    <description>
        Rain's Enchants, as a plugin of its own: the enchants module and the standard wrapper,
        shaded together.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsEnchants</plugin.name>
        <!-- 0.1.0: Veinminer, Night Vision, Flight and Double Jump as enchantments; advancements for them. -->
        <!-- 0.2.0: the flight charge and flown time follow the player across the network. -->
        <!-- 0.6.1: whoever may build on a claim may open a shard portal there (it was the fire right, which trusted players do not have). -->
        <!-- 0.6.2: a shard portal is recognised wherever the player's hitbox touches it, as the game does; stepping in from the side led to the nether. -->
        <!-- 0.7.0: thunderstorms in the shard world, 70 % of the time by default (shard-world-thunder-percent, rolled every five minutes); Boost may be set up to 1000 % of a rocket. -->
        <!-- 0.8.0: a dark red haze drifts around players in the shard world (shard-world-haze specks every half second). -->
        <!-- 0.9.0: the shard world is purple — sky, fog, clouds and light — from purple copies of the game's biomes in a datapack written at bootstrap; each chunk is switched to them once. -->
        <!-- 0.10.0: Heat-seeking (bows, crossbows, tridents, I–III): a shot locks onto the creature nearest the aim that the shooter may hurt and flies into it. -->
        <!-- 0.11.0: Thor — an axe or mace thrown like Mjölnir (lightning, flies back; the weapon never leaves the inventory), a trident calls a storm where it lands; the shard world's rain spares its endermen; shards-per-hour 0 is no limit; a hunting creature no longer fails on a target gone to another world. -->
        <!-- 0.12.0: the Crystal Wither — built like a wither, of amethyst blocks, in the shard world; a wither of the Crystal kind. -->
        <!-- 0.12.1: the Crystal Wither rises only if whoever placed the last skull may break every block of the build (security review). -->
        <!-- 0.13.0: Volley — a thrown trident brings two (I) or four (II) more, fanned out like Multishot; the copies cannot be picked up, never come back and are gone soon after landing. -->
        <!-- 0.14.0: a Crystal Wither killed by a player drops forty to sixty shards, rare ones likelier, outside the hourly limit. -->
        <!-- 0.15.0: shard creatures hit 30 % harder each kind up (melee, arrows, blasts); shard world creepers blow up twice as big and more (at most 12); zombie tyrants call four zombies below half health, once; skeleton tyrants fire in minigun bursts; baby zombie tyrants run 20 % faster. -->
        <!-- 0.16.0: every shard drop is 30–50 % bigger. -->
        <!-- 0.17.0: the Shard Overlord, a kind above the tyrant (1 in 100): eight times the health, 2.86 times the damage, 10–14 shards; its zombies call six Crystal ones, its skeletons fire the minigun. -->
        <!-- 0.18.0: the Crystal Warden — 2 in 1000 monsters under the shard world's open sky come as a warden of any kind, worth five times its shards; tyrants three times as common (6 in 100). -->
        <plugin.version>0.18.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>enchants-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
