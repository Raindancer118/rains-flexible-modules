<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>moderation-module</artifactId>
    <!-- Own version, independent of the reactor's: this module is published to the registry on its own
         schedule under its own tag (moderation-module-vX.Y.Z), not tied to any other module's release. -->
    <version>${moderation-module.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Moderation</name>
    <description>
        The moderator's half of the server: the commands, the screens, the reasons, the escalation
        ladder, the reports and the staff notes. The punishments themselves — who is banned, muted or
        frozen, and for how long — are RainsCore's, so a server that removes this module still enforces
        every ban it has already handed out.
    </description>

    <dependencies>
        <!-- The anti-ESP shield's packet tap sits in the server's own Netty pipeline; the server ships Netty. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>4.2.7.Final</version>
            <scope>provided</scope>
        </dependency>
        <!-- Grim is installed beside the plugin on each server; only its API is compiled against, never shaded. -->
        <dependency>
            <groupId>ac.grim.grimac</groupId>
            <artifactId>GrimAPI</artifactId>
            <version>${grimapi.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Paper ships the SQLite driver on a server; a test has to bring its own to search the chat log. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${modules-api.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- RainsCore's testkit: real item stacks without a server, for the vault. -->
        <dependency>
            <groupId>de.raindancer</groupId>
            <artifactId>RainsCore</artifactId>
            <version>${rainscore.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
