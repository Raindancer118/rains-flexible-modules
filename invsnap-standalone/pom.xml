<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>invsnap-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Inventory Snapshots</name>
    <description>
        Rain's Inventory Snapshots, as a plugin of its own. Nothing here but a build file and a
        descriptor: the invsnap module and the standard wrapper are shaded together, and that is
        the whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsInventorySnapshots</plugin.name>

        <!-- 1.0.0: the first release of this as a plugin. There is no earlier version line.

             1.1.0: bare /invsnap opens a picker of every player this server has a snapshot of,
             for when an admin does not already know a name — /invsnap <player> still skips
             straight to that player's own history. Picking a snapshot from a player's history no
             longer restores it on the spot: it opens an action menu with three doors instead —
             Inspect (every item, exactly as it was, read-only), Compare to now (the same, but each
             slot says whether it still matches what the player is carrying right now), and Restore
             (the old confirm-then-overwrite, unchanged, still gated on the restore permission). -->
        <plugin.version>1.1.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>invsnap-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
