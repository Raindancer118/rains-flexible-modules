<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>manhunt-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Manhunt</name>
    <description>
        Rain's Manhunt, as a plugin of its own. Nothing here but a build file and a descriptor: the
        manhunt module and the standard wrapper are shaded together, and that is the whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsManhunt</plugin.name>

        <!-- Deliberately below 1.0.0, and staying there until Manhunt is actually the whole thing
             it is meant to be: 1.0.0 is the milestone, not the first build that runs.
             0.1.0: the two sides, the win conditions, the whitelist, chaos, the waiting lobby.
             0.2.0: the Hunters carry a tracking compass.
             0.3.0: a countdown, death rules, narration, side chat, borrowed rules, spectators.
             0.4.0-0.5.0: the Hunter aims their own compass, the curated screens, the map page.
             0.6.0: hunt history — every finished hunt remembered, /manhunt history and a per-player
             record, the last thing manhunt-roadmap-to-1-0 named as still missing before 1.0.0.
             0.6.1: /whitelist's passthrough no longer dumps a stack trace at the console for a word
             that is neither this module's nor vanilla's own.
             0.6.2: a Hunter's tracking compass is never silently lost to a full inventory — it goes
             to their feet instead, and the "handed a compass" message no longer lies about it.
             0.6.3: one concern failing as a hunt starts no longer abandons the ones after it (which
             is how the compass handout, last of five, went missing on a live server), and the
             locator bar is switched off for the length of a hunt.
             0.7.0: the clock moves out of the boss bar and onto the action bar, counting from zero
             at the hunt's own start, and a tracking compass no longer drops from a dead Hunter.
             0.8.0: side chat is visible — every line tagged with its channel, like staff chat, and
             each side told when the hunt makes its chat private.
             0.8.1: no boss bar at all any more — neither during the countdown nor during the hunt.
             0.9.0: the compass needle comes from the player's compass target in the overworld, so the
             item is never rewritten while chasing; the distance moves to the action bar.
             0.9.1: a hunt the Hunters could never win (all-runners-dead against respawning Runners)
             is refused with a reason, and a respawning Runner is no longer told they have 2147483646
             lives left.
             0.9.2: refuses to start against a RainsSpeedrun older than 1.10.0, naming the jar to
             replace instead of dying with an IllegalAccessError.
             0.10.0: everybody starts evenly around one circle at the hunt world's spawn, sized by the
             roster, facing the middle.
             0.10.1: found with two real clients — speedrun's lobby items are taken off at the start,
             the start teleport is no longer narrated as a dimension change, and an unchanged compass
             target is not re-sent.
             0.11.0: rebuilt as a game the speedrun lobby plays, rather than a second lobby beside it.
             One world, one compass, one start block, one countdown, one clock, one reset — all of
             them RainsSpeedrun's — and what is left here is the two sides, the tracking compass,
             elimination, and the server's own door. Needs RainsSpeedrun 1.11.0 or newer. -->
        <plugin.version>0.12.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>manhunt-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
