<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>speedrun-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Speedrun</name>
    <description>
        Rain's Speedrun, as a plugin of its own. Nothing here but a build file and a descriptor: the
        speedrun module and the standard wrapper are shaded together, and that is the whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsSpeedrun</plugin.name>

        <!-- 1.0.0: the first release of this as its own plugin — split out of RainsCore, where it
             briefly lived built in, after a join handler there cleared a player's inventory on every
             join anywhere on the server. Not a rebuild of an earlier standalone speedrun plugin.
             1.1.0: a run hazard — breaking a block, or opening a chest/container, spawns a creeper,
             occasionally charged, each with its own toggle and its own chance from the lobby menu.
             1.2.0: the on/off hazard toggles became spawn-chance percentages; /lemmemove, /starthere,
             /speedrunreset and /speedrunspectate; and every setting (not only the goal/death policy)
             the lobby menu shows can now be reached mid-run where it actually applies live.
             1.2.1: /speedrunreset now deletes and remakes the world from scratch even while READY
             with nothing running, instead of refusing — "regenerate" always meant a full wipe, not a
             revert, whatever state the world happened to be in.
             1.3.0: the lobby's own world reset/create/delete now runs on RainsCore's generic
             WorldRegenerator (requires RainsCore 1.29.1+) instead of a copy of the same logic —
             occupants are evacuated to wherever they actually were before entering the world, not a
             generic spawn. The lobby world is also created automatically on first enable if it does
             not exist yet, defaulting to a dedicated "speedrun" world rather than the server's own
             primary one, which can never be regenerated at all. -->
        <plugin.version>1.3.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>speedrun-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
