<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>cosmetics-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Cosmetics</name>
    <description>
        Rain's Cosmetics as a plugin of its own: the cosmetics module and the standard wrapper,
        shaded together.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsCosmetics</plugin.name>

        <!-- 0.x until the first complete version is signed off.
             0.14.0: Paper 26.3 natively (paper-api 26.3, api-version 26.3); no longer loads on 26.2. -->
        <!-- 0.16.0: on a server that follows another over RainsCore's link (the arena), cosmetics come from there:
             the rainscosmetics data is carried over, nothing is taken off on join, and they are chosen there. Needs
             RainsCore 1.120.0. -->
        <!-- 0.16.1: typed name styles are read by RainsCore 1.126.0 TypedStyles (same words, shared with guilds). -->
        <!-- 0.17.0: RainsCore 2.0 network — the palette and presets are catalogue.yml, purchases and wing reservations are the network's documents (a purchase follows the player, a reservation holds on every server), all read again when another server writes. -->
        <!-- 0.18.0: network — the teleport look is read back from the player's data whenever it changes (a look chosen on another server now plays after arriving, no relog), and /cosmetics clear takes the particle off somebody on another server. -->
        <plugin.version>0.18.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>cosmetics-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is a version that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
