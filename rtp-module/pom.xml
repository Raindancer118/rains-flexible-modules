    <artifactId>rtp-module</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Random Teleport</name>
    <description>
        Send a player somewhere random in their own world, inside a ring an owner sets. The warm-up,
        the movement cancelling, the search for solid ground and the teleport itself are RainsCore's
        Travel — the same code warps, homes and teleport requests use. What is here is the ring
        itself, the cooldown and which worlds this runs in at all.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
