<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>speedrun-e2e</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Speedrun — end-to-end scenarios</name>
    <description>
        RainsSpeedrun, Manhunt included, played on a real Paper server by headless bots — every command
        word, menu page and button, setting, chat button, lobby state and Manhunt behaviour. The normal
        build only checks that each of them has a scenario (CoverageTest); scripts/e2e.sh plays them.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>e2e-harness</artifactId>
            <version>${e2e-harness.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Read, never run: the coverage catalogue is built from its words, menus and settings. -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>speedrun-module</artifactId>
            <version>${speedrun-module.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Built before this module, so the scenarios play the jar this build just made. -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>speedrun-standalone</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${e2e.excluded}</excludedGroups>
                    <groups>${e2e.groups}</groups>
                    <!-- One server at a time: scenarios share the machine's ports, CPU and patience. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <e2e.rainscore>${settings.localRepository}/de/raindancer/RainsCore/${rainscore.version}/RainsCore-${rainscore.version}.jar</e2e.rainscore>
                        <e2e.plugin.dir>${project.basedir}/../speedrun-standalone/target</e2e.plugin.dir>
                        <e2e.sources>${project.basedir}/../speedrun-module/src/main</e2e.sources>
                        <e2e.screenshots>${project.basedir}/../docs/screenshots</e2e.screenshots>
                    </systemPropertyVariables>
                    <!-- In order, by name: the coverage check of what was played goes last (ZzRuntimeCoverage). -->
                    <runOrder>alphabetical</runOrder>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
