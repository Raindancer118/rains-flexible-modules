<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>rtp-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Random Teleport</name>
    <description>
        Rain's Random Teleport, as a plugin of its own. Nothing here but a build file and a
        descriptor: the rtp module and the standard wrapper are shaded together, and that is the
        whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsRandomTeleport</plugin.name>

        <!--
          1.0.0: the first release of this as a plugin. There is no earlier version line.

          1.1.0: a checked landing's fallback search — the one that runs when the world's heightmap
          has no standing room within a few blocks of what it reported, a thick canopy or a cave mouth
          most often — used to walk the entire column with nothing stopping it, so it could tunnel
          straight through solid rock into any cave it found first, however deep. Bounded now, in
          RainsCore (1.12.0, see its own history), to a sane distance from the heightmap's own answer.
          Landings also now prefer a grass block over sand, gravel or bare stone, and a spot with clear
          sky above over one under a tree's canopy, whenever a checked search has a choice between
          otherwise equally good spots — never a reason to widen the search or refuse one, only a tie
          -break. And the location pool tops itself up by one more after every trip that uses it, not
          only once a day, so a server busy enough to empty it stays ahead rather than falling back to
          a live search until the next day's job runs.

          1.1.1: kept in step with rtp-module's own version.
        -->
        <plugin.version>1.1.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>rtp-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
