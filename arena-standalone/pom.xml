<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>arena-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Arena</name>
    <description>
        Rain's Arena, as a plugin of its own. Nothing here but a build file and a descriptor: the arena module and
        the standard wrapper are shaded together, and that is the whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsArena</plugin.name>

        <!-- 0.1.0: arena worlds built from a schematic with a border just past the map, a hub, /arena in and
             /arena leave out; whatever a player carries is put away on the way in and handed back on every way out
             (leaving, quitting, any teleport out, a crash), deaths in the arena cost nothing. -->
        <!-- 0.1.1: the protection closed where adventure mode alone left gaps — items used against blocks (only
             fighting gear, food and potions work), entity-shaped things placed or broken (boats, minecarts, stands,
             crystals, paintings), shears, leads, fish buckets, signs; mobs and falling blocks changing blocks; fire,
             burning, spreading, fading, forming, growing; arrows breaking pots or lighting TNT. -->
        <!-- 0.2.0: the fights — duels and sumo by invite or queue, teams of two or three and free for all from
             the queue, best of 1/3/5, nine kits (kits.yml, admins save their own), own gear as a copy fetched from
             survival, stakes held on survival and paid out or given back (retried until done), mob waves with six
             presets or set up by hand (mobs never burn, drop nothing, stay in their pit), a blow that would kill is a
             defeat, countdown freeze, pit confinement, spectating, stats and leaderboards, gladiator NPCs, menus,
             /pvp invite|accept|deny|queue|leave. -->
        <!-- 0.2.1: one gate for every way into a fight (queue, invite, arrival): the stake limit, a known kit, and
             survival reachable for stakes or own gear; survival is told before somebody is sent back. -->
        <!-- 0.2.2: gladiators can be placed from the console at coordinates (RainsCore 1.116.0). -->
        <!-- 0.2.3: survival is told whenever somebody agrees here to a stake or to their own gear; a bare
             /pvp accept with several invites open picks none; every pit is swept of what a fight leaves (arrows,
             tridents, clouds, experience, fireworks, fangs, stray mobs) before each round, after each fight and once
             a minute while empty, and fighters come home without arrows stuck in them. -->
        <!-- 0.2.4: a wither or an ender dragon is never let into an arena world, /summon included. -->
        <!-- 0.2.5: the hub holds survival's players through an update — /arena admin hold <names|all>, sent back by
             themselves when survival says it is up (or /arena admin return), a fighter after their fight. -->
        <!-- 0.2.6: the maps are kept as built by RainsCore's locked worlds (1.117.0) — the same protection, now
             shared with the hub; the arena adds only no item entities and no portals. -->
        <!-- 0.3.0: a Watcher gladiator opens the fights going on to watch; whoever accepts an invite is told so, a second
             click on [Accept] too, and both are told when every pit is busy; a newer agreed fight replaces an older one
             of the same players; stats are read off the server thread. -->
        <!-- 0.4.0: /balance and /pay with the survival server's money (RainsCore's linked economy); a fall is a flash of
             lightning, soul fire and thunder, a win a title and a burst; congratulations in many wordings; 64 wind
             charges in the mace kit; a leaderboard over the hub (/arena admin board place). /pay runs on survival under
             its economy's own rules. Needs RainsCore 1.120.1. -->
        <!-- 0.5.0: [Rematch] after a fight; fights waiting for more people are announced in the hub (and on arrival) with [Join] (/pvp join); the lanista challenges a player directly, here or on survival. -->
        <!-- 0.5.1: [Join] carries the fight it showed; a player who switched queues since is not joined into a fight (or stake) the clicker never saw. -->
        <!-- 0.5.2: the [Join] fingerprint is SHA-256 (64 bits), not String.hashCode — a chosen stake cannot forge it. -->
        <!-- 0.6.0: naval battles — the pit floods as a scene (horn, thunder, rain, waterfalls, rising water), everybody in a boat on a ring, tridents; sealed so no water leaves the pit, every block put back after (and after a crash, from floods/); the naval kit. -->
        <!-- 0.6.1: /arena admin flood|drain <pit>: the naval flood without a fight, to watch it or check a pit holds water. -->
        <!-- 0.7.0: naval: boats are lifted onto each new layer of the flood (a sunken boat throws its rider out), anybody boatless is seated on the surface when the water is up, spare boats can be placed on water (adventure mode cannot); guild wars (guild vs guild) and guild training (one guild in two sides), 2-5 a side, sides from the guilds survival reports. -->
        <!-- 0.8.0: mounted combat on saddled pigs (spear with lunge, carrot on a stick to steer, no dismounting while in the fight, pigs unhurtable); /rematch; no countdown freeze for riders (it fought the boats — the laggy start); the flood placed over ticks. -->
        <plugin.version>0.8.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>arena-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
