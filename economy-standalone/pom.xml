<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>economy-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Economy</name>
    <description>Rain's Economy as a plugin of its own: the economy module and the standard wrapper.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsEconomy</plugin.name>
        <!-- 0.19.0: role discounts (Core PriceModifiers) in the shop, sell capped under the buyer's own buy price; packs (packs.yml, /eco packs). -->
        <!-- 0.20.0: bulk discount on building blocks and iron (shop.bulk-*, hard cap 30%), role and bulk shown on their own lines, every seed priced, more packs. -->
        <!-- 0.21.0: the shop holds back what a server goal collects (Core SaleStops), with the reason on the item.
             0.23.0: Paper 26.3 natively (paper-api 26.3, api-version 26.3); no longer loads on 26.2.
             0.23.1: Bedrock players (Floodgate ids) are players again: on /baltop, sidebar, boards, wealth tax, seasons.
             0.24.0: harder advancements pay more, and say what they paid; mob drops sell (a cheap item sells for a coin).
             0.25.0: the sell price explains itself under it, like the buy price.
             0.26.0: treasure enchantments (Mending…) are for sale as books by default.
             0.27.0: /claimadvancements — once, back pay for advancements made before they paid (or paid less).
             0.27.1: back pay recorded per advancement in the ledger; not in creative/spectator or without earn. -->
        <plugin.version>0.27.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>economy-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
