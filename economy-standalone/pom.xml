<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>economy-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Economy</name>
    <description>Rain's Economy as a plugin of its own: the economy module and the standard wrapper.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsEconomy</plugin.name>
        <!-- 0.19.0: role discounts (Core PriceModifiers) in the shop, sell capped under the buyer's own buy price; packs (packs.yml, /eco packs). -->
        <!-- 0.20.0: bulk discount on building blocks and iron (shop.bulk-*, hard cap 30%), role and bulk shown on their own lines, every seed priced, more packs. -->
        <!-- 0.21.0: the shop holds back what a server goal collects (Core SaleStops), with the reason on the item.
             0.23.0: Paper 26.3 natively (paper-api 26.3, api-version 26.3); no longer loads on 26.2.
             0.23.1: Bedrock players (Floodgate ids) are players again: on /baltop, sidebar, boards, wealth tax, seasons.
             0.24.0: harder advancements pay more, and say what they paid; mob drops sell (a cheap item sells for a coin).
             0.25.0: the sell price explains itself under it, like the buy price.
             0.26.0: treasure enchantments (Mending…) are for sale as books by default.
             0.27.0: /claimadvancements — once, back pay for advancements made before they paid (or paid less).
             0.27.1: back pay recorded per advancement in the ledger; not in creative/spectator or without earn.
             0.27.2: name tags are priced from their recipe (paper + iron nugget), no longer a rare find's 300.
             0.28.0: enchantments priced by usefulness (shop.enchant-worth), drawer sorted by it; /sell enchantments;
                    enchanted books sell again; staff call off any auction (/eco auction cancel, menus).
             0.29.0: enchanted books priced like items, one key per enchantment and level (enchanted_book:mending:1):
                    from making them (book, lapis, XP at the bottle's price, anvil) times usefulness, own supply and
                    demand, custom prices; shop.enchant-price / shop.enchant-value no longer read; /eco price.
             0.29.1: no money from books: every sale of an enchantment at the player's own capped price (roles,
                    lever, sold lately), a book never under the plain book inside, prices kept from overflowing,
                    level 0 and stacked unstackables not bought, server goals stop book sales, version agrees.
             0.31.0: potions of every kind and ominous bottles are shop items, priced like enchanted books are:
                    one key per bottle and type (potion:healing, splash_potion:strong_swiftness,
                    lingering_potion:weakness, ominous_bottle:3), brewed from a glass bottle and a third of each
                    ingredient (+ gunpowder, + dragon's breath), own supply and demand, custom prices, roles; a
                    Potions drawer (click buys one, shift click five), bought back by hand, from /sell and at
                    auctions only as the game makes them; shop.potions, shop.potions-closed,
                    shop.ominous-bottle-value; /eco price potion:healing.
             0.31.1: a bottle's item closes every potion of its form: "potion" or "splash_potion" in not-sold or
                    not-bought, or the item's drawer shut, as for any item. -->
        <!-- 0.33.0: every armour trim smithing template is priced (by how rare it is to find), so the shop sells
             them. -->
        <!-- 0.34.0: the three froglights are priced, so the shop sells and buys them like any block. -->
        <!-- 0.35.0: the heavy core is priced, so the mace is sold; firefly bushes too. -->
        <!-- 0.36.0: the sidebar carries other plugins' sections (a guild) under the balance, the richest fill what room is left (RainsCore 1.129.0). -->
        <!-- 0.37.0: tipped arrows in the shop (Potions drawer; 8 arrows + 1 lingering potion make 8, the craft markup on that; click buys 8, shift 64). -->
        <!-- 0.38.0: on a network — the cash key is the network's secret (old cash.key carried over, money stays good), /pay from other servers through the bank. -->
        <!-- 0.39.0: a server that is not the network's bank runs /balance, /pay and /baltop against it (no ledger of its own); the bank answers /baltop and tells payees on other servers; pay/gamble waits follow the player; the ledger loads and saves on PostgreSQL. -->
        <!-- 0.39.1: PostgreSQL fixes: no INSERT OR IGNORE (auction claims, notes, gamble insurance), the flows report reads its boolean column as one; every store test runs on both dialects. -->
        <plugin.version>0.40.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>economy-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
