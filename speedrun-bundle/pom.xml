<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>speedrun-bundle</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Speedrun Server</name>
    <description>
        A speedrun server in one jar: the speedrun lobby, Manhunt as a game that lobby plays, the chat
        (with Manhunt's team chat), and the world tools (world gate, /w, /dim, worlds and seeds), with
        RainsCore installed alongside.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!--
          Its own name, not RainsSpeedrun's: installed beside a RainsSpeedrun, RainsManhunt,
          RainsChat or RainsWorldUtils jar, two copies of a module would be two lobbies, two portal listeners.
          Replace those jars with this one, never add it to them.

          Five modules, so each gets a subfolder: plugins/RainsSpeedrunServer/modules/<id>/. A server
          coming from the single jars moves each plugin's files into the matching subfolder.
        -->
        <plugin.name>RainsSpeedrunServer</plugin.name>
        <!-- 0.1.0: speedrun 1.20.0, manhunt 0.17.1, worldgate 1.1.0, worldutils 0.1.1. Needs RainsCore 1.39.0.
             0.2.0: RainsChat 1.4.0 comes along, so Manhunt's /chat team works without a second jar.
             0.3.0: chat 1.5.0 — private chats by invitation (/chat private <name>, click to join).
             0.4.0: chat 1.6.0 (channels a module delivers itself, e.g. staff chat). Needs RainsCore 1.40.0.
             0.5.0: chat 1.7.0 — the latest choice wins between a private chat and a channel. Needs RainsCore 1.41.0.
             0.6.0: speedrun 1.21.0, manhunt 0.18.0 — /manhunt give, goal remove, leave mid-hunt, a hunt without a goal.
             0.7.0: speedrun 1.22.0, manhunt 0.19.0 — /speedrunresume, /speedruntime, /manhunt give all,
             lobby items no longer clear inventories. -->
        <plugin.version>0.7.0</plugin.version>
    </properties>

    <dependencies>
        <!-- Compile scope here, unlike in manhunt-standalone: one jar, one classloader, one
             SpeedrunSession — the reason RainsManhunt.jar must not shade it does not apply. -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>speedrun-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>manhunt-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>chat-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>worldgate-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>worldutils-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- BundleJarTest reads the jar this build produces, so it has to run after it exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
