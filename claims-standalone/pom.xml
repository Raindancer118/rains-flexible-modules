<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>claims-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Extended Claims</name>
    <description>
        Rain's Extended Claims, as a plugin of its own. Nothing here but a build file and a descriptor:
        the claims module and the standard wrapper are shaded together, and that is the whole plugin.
        The name and the data folder are unchanged from the standalone plugin it replaces, so a server
        upgrading keeps its claims.
    </description>

    <properties>
        <!-- What the server sees. Kept apart from the reactor's version so the plugin can be released on its
             own schedule if it ever needs to be. -->
        <!--
          The name the server sees, and the name of its data folder. Kept as it was, deliberately:
          an upgrading server has plugins/RainsExtendedClaims/ full of claims, and a renamed plugin
          would come up looking at an empty folder and report that it had no claims at all.
        -->
        <plugin.name>RainsExtendedClaims</plugin.name>

        <!--
          Rain's Extended Claims' own version line, continued — not the reactor's.

          2.0.0 rather than 1.7.0 because this is the plugin rebuilt on a new foundation rather than a
          release of the old one: the protection and the flags moved into RainsCore, the screens were
          redrawn, and the plugin now ships as a module that RainsSMPCore can also host. Nothing an owner
          configured is lost — claims, config and messages from 1.2.2 onwards are read and brought
          forward — but a major number is what says "read the notes before upgrading", and here they
          should.
        -->
        <plugin.version>2.0.2</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>claims-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is a version that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists. Surefire
              bound to a later phase rather than failsafe, which is the usual tool for this and is one more
              plugin to have cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
