<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>chat-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Chat</name>
    <description>
        Rain's Chat, as a plugin of its own. Nothing here but a build file and a descriptor: the chat
        module and the standard wrapper are shaded together, and that is the whole plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsChat</plugin.name>
        <!--
          1.0.0: format, @-mentions, a caps and repeat filter, a per-player message cooldown, and
          the staff tools — /chat clear, /chat freeze and /chat slowmode.

          1.1.0: /chatstyle — a colour and decorations for your own messages, picked from a swatch
          grid with a live preview. Behind chat.style, which defaults to operators only.

          1.2.0: tab-complete for @-mentions; the default message colour is white instead of the
          gray it used to inherit from the "<name>: " separator. The chat format setting's own
          description now shows how to add vanilla's angle brackets back around the name, for
          anybody who wants them — that was never the default and still isn't.

          1.2.1: 1.2.0's tab-complete never actually worked — it was wired to
          PlayerChatTabCompleteEvent, which Bukkit's own javadoc says has been deprecated since
          1.13 and "is no longer fired due to client changes": nothing had asked the server for
          chat-text completions over that packet in over a decade, so the handler compiled, its
          unit test passed, and a real client got nothing when pressing Tab after @. Moved to
          com.destroystokyo.paper.event.server.AsyncTabCompleteEvent, which still fires for both
          commands and plain chat (isCommand() tells the two apart). @-mention pinging itself on
          message send was unaffected by this — that path never went through the dead event — and
          a self-mention still deliberately pings nobody, unchanged from 1.0.0.
        -->
        <plugin.version>1.2.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>chat-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
