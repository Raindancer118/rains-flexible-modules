<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mannequin-module</artifactId>
    <!-- Own version, independent of the reactor's: this module is published to the registry on its own
         schedule under its own tag (mannequin-module-vX.Y.Z), not tied to any other module's release. -->
    <version>${mannequin-module.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Mannequin</name>
    <description>
        A training dummy an owner spawns, dresses and never has to worry about losing for good: real
        health that tracks every hit and combo dealt to it, blocking with a shield when it holds one,
        drinking whatever potion lands at its feet, and respawning identically — same block, same
        loadout, same skin — a moment after it is actually killed.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <!--
          provided, the same reasoning chained-module already has against speedrun-module: a
          mannequin optionally belongs to a claim, so this module compiles against Claim/ClaimServices
          to read one when it exists — but never shades claims-module in. A shaded copy alongside an
          installed claims plugin would be two independent ClaimRegistries, each with its own idea of
          which claims exist.

          Unlike chained/speedrun, this is a genuinely OPTIONAL dependency: a mannequin does not have
          to belong to a claim, and this module works exactly as before on a server with no claims
          plugin at all. Every reference to a claims-module class lives inside the
          de.raindancer.modules.mannequin.claims package, touched only after a runtime check
          (ClaimIntegration.tryLink/tryRegisterMenu) confirms the real ClaimServices is actually
          registered with Bukkit's own ServicesManager — the class is never loaded, so its unresolved
          symbols never matter, when claims is not installed.
        -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>claims-module</artifactId>
            <version>${claims-module.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${modules-api.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
