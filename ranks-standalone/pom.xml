<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ranks-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Ranks</name>
    <description>
        Rain's Ranks, as a plugin of its own: the ranks module and the standard wrapper,
        shaded together.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsRanks</plugin.name>
        <!-- 0.1.0: /rank — [OWNER], [DEV], [ADMIN]… in front of names in chat, above heads and in the tablist (Core's NameBadges), switchable per place for the server and by every player; staff give and take. -->
        <!-- 0.2.0: ranks made, changed, styled and deleted in game (/rank create, edit, delete; custom-ranks.yml); team ranks and a [TEAM] rank, the team listed on its own at the top of the tablist (RainsCore 1.127.0). -->
        <!-- 0.3.0: ranks, holders and settings follow the SMP over the network link (RainsCore 1.136.0 syncFile). -->
        <!-- 0.4.0: /rank manage — a menu to paint a rank's tag (the colour editor), change its text, title, weight and team, make and delete ranks. -->
        <!-- 0.4.1: every change in the manage menus asks for the admin permission again. -->
        <plugin.version>0.4.1</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>ranks-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
