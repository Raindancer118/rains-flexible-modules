<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>chained-module</artifactId>
    <!-- Own version, independent of the reactor's: this module is published to the registry on its own
         schedule under its own tag (chained-module-vX.Y.Z), not tied to any other module's release. -->
    <version>${chained-module.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — Chained</name>
    <description>
        Two players, mechanically chained together — a speedrun challenge module: get too far apart
        and further separation is simply blocked, an arbitrary end condition (an advancement, a
        death, or manual) stops the clock, and the map can be reset with a fixed or a fresh random
        seed between attempts.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
        </dependency>
        <!--
          provided, the same reasoning as paper-api and RainsCore at the reactor's own root: this
          module's classes come from RainsSpeedrun at runtime, which chained-standalone's own
          paper-plugin.yml now declares as a second required host plugin (join-classpath, both
          phases) alongside RainsCore. Shading speedrun-module into RainsChained.jar as well would put
          a second copy of SpeedrunSession/SpeedrunTimer/the end conditions on the server the moment
          both plugins are installed — a second "who is still around" and a second "did this run
          already finish", each with its own idea of the answer.
        -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>speedrun-module</artifactId>
            <version>${speedrun-module.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-api</artifactId>
            <type>test-jar</type>
            <version>${modules-api.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
