<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>arenagate-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Arena Gate</name>
    <description>
        Rain's Arena Gate, as a plugin of its own — for the survival server, beside an arena server running Rain's Arena.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsArenaGate</plugin.name>

        <!-- 0.1.0: /arena sends a player to the arena server through the proxy after a short stand-still
             (moving or being hurt calls it off). Nothing they own leaves this server. -->
        <!-- 0.2.0: /pvp invite|accept|deny|queue and /arena wave|queue — invites between players here, and across
             to the arena and back; stakes held in escrow here (SQLite, settled once, never more than the pot, a house
             cut setting, stale stakes go back after two hours); copies of gear for own-gear fights, from the live
             inventory or the saved player file; "went to the arena" / "is back from the arena" instead of quit and
             join. -->
        <!-- 0.2.1: a stake is taken and a copy of gear handed out only for a player who agreed to it (here, or
             announced by the arena as they queued or accepted there), payouts only to those who staked, a summon only
             for an invite really made from here, a bare /pvp accept only with exactly one invite open, and the arena is
             told what somebody wants only after the countdown. -->
        <!-- 0.2.2: once this server has finished starting, the arena is told, so whoever waited in its hub through
             the restart comes back by themselves. -->
        <!-- 0.3.0: [Cancel] on a sent invite (here and across), names on the arena tab-complete, an expired invite no
             longer blocks asking again. Needs RainsCore 1.118.0. -->
        <!-- 0.3.1: a vanished player is not online as far as the arena is told (invites, payments). -->
        <!-- 0.4.0: naval battles can be asked for from survival (/pvp invite <player> naval); arena-api 0.2.0. -->
        <!-- 0.5.0: answers the arena which guild a player fights for (Core Groups), for guild wars. -->
        <plugin.version>0.5.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>arenagate-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
