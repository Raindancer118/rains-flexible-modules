<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>essentials-standalone</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Essentials</name>
    <description>
        Rain's Essentials, as a plugin of its own. Nothing here but a build file and a descriptor:
        the essentials module and the standard wrapper are shaded together, and that is the whole
        plugin.
    </description>

    <properties>
        <!-- Terminal deployable plugin jar, not a Maven library: never published to the registry. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <plugin.name>RainsEssentials</plugin.name>
        <!--
          1.1.0: /unignore, a one-way undo beside the existing toggling /ignore. And a blocklist for
          /nick — two configurable lists of names nobody may wear as a nickname, one refused and
          reported to staff automatically, the other refused, reported, and banning the player for a
          day on top. The ban goes through moderation-module's own PunishmentService when that
          plugin is installed (see its own 2.18.0 history), falling back to Core's bare Punishments
          when it is not.

          1.2.0: the nickname blocklist moved out of /settings and into its own hand-editable file,
          plugins/RainsEssentials/blocklist.yml (or the module's own data folder, hosted) — a list
          edited constantly reads and edits far better as a plain YAML file than as one comma-joined
          settings line, and it is now organised into named sections (e.g. "political-figures",
          "hate-and-extremist-figures") each with its own enabled switch, so a server can turn a
          whole category off — political names, say — by flipping one line, without touching the
          names themselves. Ships with a starting set in three sections; add or remove names, or
          whole sections, freely.

          1.3.0: /blocklist opens an in-game editor for the same file — a scrollable page listing
          every section (its status, its action, how many names), click to switch a section on or
          off, shift-click to open its own page of names, click one there to remove it, or type a
          new one in with the "Add a name" button. Every change writes straight to blocklist.yml, so
          the menu and a text editor are two ways into the exact same file, never two copies of it.
          The starting set is also a great deal bigger now: two dozen more names each across
          hate-and-extremist-figures, political-figures and celebrities.

          1.3.1: the blocklist editor moved from its own /blocklist command to /nick blocklist — a
          player never opens it, and whoever may manage it already knows /nick is where nicknames
          are decided, so it is a subcommand of the one command they already know rather than a
          second top-level one to remember.

          1.4.0: bare /nick opens a menu instead of clearing your nickname — your current one (if
          any), a button to set a new one (typed in chat, through the same validation and blocklist
          checks /nick <name> always had), a button to remove it, and, for whoever may manage it,
          a shortcut straight into the blocklist editor. /nick <name> and /nick off are unchanged.

          1.5.0: /players — everybody the server has ever seen, online first, offline included, as
          a browsable list. Bare /seen (no name given) opens the same list instead of a usage line;
          picking somebody reports exactly what /seen <name> already would, vanished players shown
          as though already logged off rather than leaked or dropped.

          1.6.0: /player <name> — straight to one profile rather than browsing for it; picking
          somebody in /players or bare /seen now opens Core's ProfileMenu instead of only the seen
          report, with a "Message" button of this module's own; and /seen <name>'s own report now
          prints the name as a click-to-open-profile link instead of plain text.
        -->
        <plugin.version>1.6.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>essentials-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
