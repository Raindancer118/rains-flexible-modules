<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.raindancer.modules</groupId>
    <artifactId>rains-flexible-modules</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Rain's Flexible Modules</name>
    <description>
        Whole features, each one a Maven artifact rather than a copied folder — so a plugin gets the
        real thing and the source stays the single place it is written. Each one also ships as a
        plugin of its own through the standard wrapper, without being written twice.
    </description>

    <properties>
        <!--
          Paper 26.2 ships class files at version 69. A JDK below 25 cannot read paper-api at all, so
          this is a floor rather than a preference: lowering it produces a build failure, not a more
          portable jar.
        -->
        <java.version>25</java.version>
        <paper.api.version>26.2.build.111-stable</paper.api.version>
        <rainscore.version>1.24.0</rainscore.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <mockito.version>5.21.0</mockito.version>

        <!-- One property per library module, each its own version — independent of the reactor's
             <version> and of each other. Bumping one of these is what a <module>-vX.Y.Z release tag
             is checked against; nothing else in this file ties a module's version to another's. -->
        <modules-api.version>1.1.0</modules-api.version>
        <modules-wrapper.version>1.0.0</modules-wrapper.version>
        <!-- Matches each module's corresponding *-standalone plugin.version — the real, accumulated
             version of that feature (see claims-standalone etc.), not the reactor's own 1.0.0. -->
        <claims-module.version>2.3.0</claims-module.version>
        <moderation-module.version>2.18.0</moderation-module.version>
        <names-module.version>2.1.0</names-module.version>
        <warp-module.version>1.2.1</warp-module.version>
        <homes-module.version>2.3.1</homes-module.version>
        <tpa-module.version>2.1.1</tpa-module.version>
        <farmworld-module.version>1.1.2</farmworld-module.version>
        <pack-module.version>1.0.0</pack-module.version>
        <chained-module.version>1.0.0</chained-module.version>
        <rtp-module.version>1.1.1</rtp-module.version>
        <essentials-module.version>1.4.0</essentials-module.version>
        <worldgate-module.version>1.0.0</worldgate-module.version>
        <mannequin-module.version>1.6.0</mannequin-module.version>
        <invsnap-module.version>1.1.0</invsnap-module.version>
        <hungergames-module.version>2.8.1</hungergames-module.version>
        <!-- Split out of RainsCore 13.08.2026, after a join handler there cleared a player's
             inventory on every join anywhere on the server — see speedrun-module's own README/javadoc
             for the incident. chained-module depends on this directly for the engine underneath it. -->
        <speedrun-module.version>1.0.0</speedrun-module.version>
        <chat-module.version>1.0.0</chat-module.version>
    </properties>

    <modules>
        <module>modules-api</module>
        <module>modules-wrapper</module>
        <module>claims-module</module>
        <module>claims-standalone</module>
        <module>moderation-module</module>
        <module>moderation-standalone</module>
        <module>names-module</module>
        <module>names-standalone</module>
        <module>warp-module</module>
        <module>warp-standalone</module>
        <module>homes-module</module>
        <module>homes-standalone</module>
        <module>tpa-module</module>
        <module>tpa-standalone</module>
        <module>essentials-module</module>
        <module>essentials-standalone</module>
        <module>chat-module</module>
        <module>chat-standalone</module>
        <module>farmworld-module</module>
        <module>farmworld-standalone</module>
        <module>pack-module</module>
        <module>pack-standalone</module>
        <module>rtp-module</module>
        <module>rtp-standalone</module>
        <module>mannequin-module</module>
        <module>mannequin-standalone</module>
        <module>worldgate-module</module>
        <module>worldgate-standalone</module>
        <module>invsnap-module</module>
        <module>invsnap-standalone</module>
        <!-- Before chained-module: chained-module depends on speedrun-module's engine classes, and a
             reactor builds in the order it is given. -->
        <module>speedrun-module</module>
        <module>speedrun-standalone</module>
        <module>chained-module</module>
        <module>chained-standalone</module>
        <!--
          Archived 2026-08-14: not being worked on for a while, and there is no value in the reactor
          spending a build and 850+ tests on it every push in the meantime. The code is untouched on
          disk — re-add these three lines (and the matching CI lines noted in build.yml) to resume.
        <module>hungergames-module</module>
        <module>hungergames-standalone</module>
        <module>hungergames-bundle</module>
        -->
        <!--
          Last, because it shades six of the modules above and a reactor builds in the order it is
          given. Every dependency it has is built by the time it is reached.
        -->
        <module>yeuksmp</module>
    </modules>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!--
          RainsCore itself: published here by its own CI on every version bump (see its build.yml),
          and read from here rather than from a sibling checkout built by hand. The id has to be
          exactly packages-releases — that is the server block a build's settings.xml carries the
          read credentials under, the same one distributionManagement below writes with.
        -->
        <repository>
            <id>packages-releases</id>
            <url>https://packages.tstieh.de/releases</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>modules-api</artifactId>
                <version>${modules-api.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>modules-wrapper</artifactId>
                <version>${modules-wrapper.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>claims-module</artifactId>
                <version>${claims-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>moderation-module</artifactId>
                <version>${moderation-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>names-module</artifactId>
                <version>${names-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>warp-module</artifactId>
                <version>${warp-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>homes-module</artifactId>
                <version>${homes-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>tpa-module</artifactId>
                <version>${tpa-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>essentials-module</artifactId>
                <version>${essentials-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>farmworld-module</artifactId>
                <version>${farmworld-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>pack-module</artifactId>
                <version>${pack-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>hungergames-module</artifactId>
                <version>${hungergames-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>rtp-module</artifactId>
                <version>${rtp-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>mannequin-module</artifactId>
                <version>${mannequin-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>worldgate-module</artifactId>
                <version>${worldgate-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>invsnap-module</artifactId>
                <version>${invsnap-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>chained-module</artifactId>
                <version>${chained-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>speedrun-module</artifactId>
                <version>${speedrun-module.version}</version>
            </dependency>
            <dependency>
                <groupId>de.raindancer.modules</groupId>
                <artifactId>chat-module</artifactId>
                <version>${chat-module.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          provided in both cases, and that is the whole delivery model. The server has already loaded
          one Paper and one RainsCore; a module carrying its own copy of either would get a second
          action bar owner, a second item registry and a second scoreboard arbiter, none of which
          would know about anybody else's. Shading these in is the exact problem RainsCore exists to
          remove, so the build refuses to make it possible.
        -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>de.raindancer</groupId>
            <artifactId>RainsCore</artifactId>
            <version>${rainscore.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                          javac in its own process rather than inside Maven's JVM. Not a preference:
                          compiling claims-module's test sources from clean crashed the in-process
                          compiler with a bare NullPointerException out of JavaxToolsCompiler and no file,
                          no line and no message — while the identical javac command line, same release,
                          same lint flags, same classpath, compiled them without a complaint. A forked
                          compiler is the same compiler with its own heap and its own shared-state, and it
                          does not do it.

                          The failure is worth describing because of how it presents: `mvn verify` on an
                          existing target/ passes, since there is nothing to recompile, and only a clean
                          build fails. So it looks like a change broke the build when nothing did.
                        -->
                        <fork>true</fork>
                        <compilerArgs>
                            <arg>-Xlint:all,-serial,-processing</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!--
                          Mockito's inline mock maker instruments classes through Byte Buddy, which as
                          shipped with the Mockito version above does not yet recognise Java 25 (class
                          file 69) bytecode — the JDK this project already requires — and refuses to mock
                          anything without this. See java.version above for why 25 is not optional here.
                        -->
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                </plugin>
                <!--
                  What turns a module into a plugin. A standalone project declares the module and the
                  wrapper as its only dependencies and enables this; the result is one jar Paper can
                  load, with the module's classes, the wrapper's, and nothing else. paper-api and
                  RainsCore are provided and therefore never in it.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <filters>
                                    <filter>
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/MANIFEST.MF</exclude>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                            <exclude>module-info.class</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                                <transformers>
                                    <!--
                                      Modules are found by ServiceLoader, so two modules in one
                                      standalone jar have two service files with the same name. Without
                                      this one of them wins and the other module is simply not there —
                                      no error, no log line, just a feature missing.
                                    -->
                                    <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Applies to every module by inheritance. The terminal *-standalone/*-bundle modules and yeuksmp
         opt back out via maven.deploy.skip=true — they are deployable plugin jars for a server's
         plugins/ folder, not Maven libraries anyone depends on. -->
    <distributionManagement>
        <repository>
            <id>packages-releases</id>
            <url>https://packages.tstieh.de/releases</url>
        </repository>
    </distributionManagement>
</project>
