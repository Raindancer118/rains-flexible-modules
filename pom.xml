<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.raindancer.modules</groupId>
    <artifactId>rains-flexible-modules</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Rain's Flexible Modules</name>
    <description>
        Whole features, each one a Maven artifact rather than a copied folder — so a plugin gets the
        real thing and the source stays the single place it is written. Each one also ships as a
        plugin of its own through the standard wrapper, without being written twice.
    </description>

    <properties>
        <!--
          Paper 26.2 ships class files at version 69. A JDK below 25 cannot read paper-api at all, so
          this is a floor rather than a preference: lowering it produces a build failure, not a more
          portable jar.
        -->
        <java.version>25</java.version>
        <paper.api.version>26.3.build.169-beta</paper.api.version>
        <rainscore.version>1.93.0</rainscore.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <!-- The end-to-end harness and its headless client: one timestamped 26.3 build, never the moving SNAPSHOT. -->
        <e2e-harness.version>0.5.0</e2e-harness.version>
        <mcprotocollib.version>26.3-20260925.105100-9</mcprotocollib.version>
        <!-- Which tests run: everything but the e2e ones, unless -Pe2e turns it round. -->
        <e2e.excluded>e2e,screenshots</e2e.excluded>
        <e2e.groups></e2e.groups>
        <mockito.version>5.21.0</mockito.version>

        <!-- One property per library module, each its own version — independent of the reactor's
             <version> and of each other. Bumping one of these is what a <module>-vX.Y.Z release tag
             is checked against; nothing else in this file ties a module's version to another's. -->
        <modules-api.version>1.2.0</modules-api.version>
        <modules-wrapper.version>1.3.0</modules-wrapper.version>
        <!-- Matches each module's corresponding *-standalone plugin.version — the real, accumulated
             version of that feature (see claims-standalone etc.), not the reactor's own 1.0.0. -->
        <claims-module.version>2.9.0</claims-module.version>
        <moderation-module.version>2.32.0</moderation-module.version>
        <names-module.version>2.3.0</names-module.version>
        <cosmetics-module.version>0.14.0</cosmetics-module.version>
        <warp-module.version>1.7.0</warp-module.version>
        <homes-module.version>2.6.0</homes-module.version>
        <tpa-module.version>2.4.0</tpa-module.version>
        <farmworld-module.version>1.4.0</farmworld-module.version>
        <pack-module.version>1.1.0</pack-module.version>
        <chained-module.version>1.4.0</chained-module.version>
        <rtp-module.version>1.4.0</rtp-module.version>
        <essentials-module.version>1.18.0</essentials-module.version>
        <worldgate-module.version>1.4.0</worldgate-module.version>
        <!-- 0.x until it is everything that was asked for; the first release of World Utils. -->
        <worldutils-module.version>0.4.0</worldutils-module.version>
        <mannequin-module.version>1.10.0</mannequin-module.version>
        <invsnap-module.version>1.5.0</invsnap-module.version>
        <xpbottle-module.version>1.3.0</xpbottle-module.version>
        <veintoggle-module.version>0.4.0</veintoggle-module.version>
        <performance-module.version>0.1.0</performance-module.version>
        <economy-module.version>0.25.0</economy-module.version>
        <roles-module.version>0.5.0</roles-module.version>
        <jobs-module.version>0.4.0</jobs-module.version>
        <anticheat-module.version>0.6.0</anticheat-module.version>
        <playerutils-module.version>0.3.0</playerutils-module.version>
        <xaeromap-module.version>1.3.0</xaeromap-module.version>
        <wallsroads-module.version>1.3.0</wallsroads-module.version>
        <hungergames-module.version>2.9.0</hungergames-module.version>
        <!-- Split out of RainsCore 13.08.2026, after a join handler there cleared a player's
             inventory on every join anywhere on the server — see speedrun-module's own README/javadoc
             for the incident. chained-module depends on this directly for the engine underneath it. -->
        <speedrun-module.version>1.33.0</speedrun-module.version>
        <chat-module.version>1.12.0</chat-module.version>
        <!-- Depends on speedrun-module's engine classes the same way chained-module does; see that
             module's own note in this file. -->
    </properties>

