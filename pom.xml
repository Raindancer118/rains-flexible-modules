        <module>xaeromap-module</module>
        <module>xaeromap-standalone</module>
        <!-- Back in the reactor 25.08.2026: the RainsCore API this was written against landed in
             RainsCore 1.31.0 (world.geometry, world.build, world.selection, world.visual). After
             claims-module and xaeromap-module: it compiles against both (provided, never shaded)
             for the seams in .claims and .map, and a reactor builds in the order it is given. -->
        <module>wallsroads-module</module>
        <module>wallsroads-standalone</module>

        <!-- Before chained-module: chained-module depends on speedrun-module's engine classes, and a
             reactor builds in the order it is given. -->
        <module>speedrun-module</module>
        <module>speedrun-standalone</module>
        <module>chained-module</module>
        <module>chained-standalone</module>

        <!-- Manhunt is part of speedrun-module now (de.raindancer.modules.speedrun.manhunt); the old
             manhunt-module and manhunt-standalone are no longer built. -->
        <!-- After speedrun, worldgate and worldutils: it shades them. -->
        <module>speedrun-bundle</module>
        <!--
          End-to-end: a real Paper server and headless bots. The harness is generic; speedrun-e2e holds
          RainsSpeedrun's scenarios and only runs them with -Pe2e (scripts/e2e.sh) — a normal build
          compiles them and checks that every command, button and setting has one.
        -->
        <module>e2e-harness</module>
        <module>speedrun-e2e</module>
        <module>modules-e2e</module>
        <!--
          Archived 2026-08-14: not being worked on for a while, and there is no value in the reactor
          spending a build and 850+ tests on it every push in the meantime. The code is untouched on
          disk — re-add these three lines (and the matching CI lines noted in build.yml) to resume.
        <module>hungergames-module</module>
        <module>hungergames-standalone</module>
        <module>hungergames-bundle</module>
        -->
        <!--
          Last, because it shades six of the modules above and a reactor builds in the order it is
          given. Every dependency it has is built by the time it is reached.
        -->
        <module>yeuksmp</module>
    </modules>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!--
          RainsCore itself: published here by its own CI on every version bump (see its build.yml),
          and read from here rather than from a sibling checkout built by hand. The id has to be
          exactly packages-releases — that is the server block a build's settings.xml carries the
          read credentials under, the same one distributionManagement below writes with.
        -->
        <repository>
            <id>packages-releases</id>
            <url>https://packages.tstieh.de/releases</url>
        </repository>
    </repositories>

