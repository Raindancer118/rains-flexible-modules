<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>rains-flexible-modules</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>modules-e2e</artifactId>
    <packaging>jar</packaging>

    <name>Rain's Flexible Modules — end-to-end scenarios</name>
    <description>
        Standalone module plugins played on a real Paper server by headless bots. Skipped in a normal
        build; run with -Pe2e (needs network the first time for Paper and the client jars).
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>e2e-harness</artifactId>
            <version>${e2e-harness.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Only for the build order: the scenarios start the shaded jars these produce. -->
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>cosmetics-standalone</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>moderation-standalone</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>essentials-standalone</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${e2e.excluded}</excludedGroups>
                    <groups>${e2e.groups}</groups>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <e2e.rainscore>${settings.localRepository}/de/raindancer/RainsCore/${rainscore.version}/RainsCore-${rainscore.version}.jar</e2e.rainscore>
                        <e2e.reactor>${project.basedir}/..</e2e.reactor>
                    </systemPropertyVariables>
                    <runOrder>alphabetical</runOrder>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
